# Netlify cache headers for email-shop
# HTML files: never cache
/email-shop/dist/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# JS/CSS assets: always revalidate (stable filenames, ETag/304 handles freshness)
/email-shop/dist/assets/*
  Cache-Control: no-cache, must-revalidate
