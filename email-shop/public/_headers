# Netlify cache headers for email-shop
# HTML files: never cache (so they always load the latest hashed JS/CSS)
/email-shop/dist/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Hashed assets: cache forever (hash changes on new deploy)
/email-shop/dist/assets/*
  Cache-Control: public, max-age=31536000, immutable
