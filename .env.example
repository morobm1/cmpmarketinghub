# ══════════════════════════════════════════════════════
# CMP Marketing Hub — Netlify Environment Variables
# ══════════════════════════════════════════════════════
# Copy these to Netlify Dashboard > Site Settings > Environment Variables
# DO NOT commit real secrets to git.
# ══════════════════════════════════════════════════════

# Google Apps Script Web App URL (the /exec deployment URL)
CMP_SCRIPT_URL=https://script.google.com/macros/s/AKfycbznHj5sk4ZCAfK6vF1u08uGUEj8SUm4s22Zczta3sutAm--KNHxKsS8NkP7fOLKDTD5rA/exec

# Webhook secret — must match the CMP_TASK_SECRET Script Property in Google Apps Script
CMP_TASK_SECRET=REPLACE_WITH_YOUR_SECRET

# App base URL
APP_BASE_URL=https://cmpmarketinghub.netlify.app

# RV Admit Radius Map — Client Portal signing secret
# Used ONLY by netlify/functions/rv-client-portal.js to sign/verify the
# separate client-portal session cookie. Must be different from JWT_SECRET
# (the staff session secret) so a client-portal token can never be mistaken
# for a valid staff session by other functions.
RV_CLIENT_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
