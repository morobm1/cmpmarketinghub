{
  "name": "mmp-netlify-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "build": "cd email-shop && npm install && npm run build && cd ../mplr-app && npm install && npm run build",
    "build:functions": "echo \"Netlify builds functions automatically\"",
    "deploy": "netlify deploy",
    "deploy:prod": "netlify deploy --prod",
    "test": "node --test tests/pulse-survey/handlers.test.mjs tests/pulse-survey/engine.test.mjs && node --test --experimental-test-module-mocks tests/reslife/reslife.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.9.2"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "xlsx": "^0.18.5",
    "zipcodes": "^8.0.0"
  }
}
